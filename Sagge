<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chukwuka Smart | E-Commerce Store</title>
    <!-- Simple styling layout for a clean look -->
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 20px; background-color: #f9f9f9; }
        header { text-align: center; padding: 20px; background: #fff; border-bottom: 1px solid #ddd; }
        .product-grid { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; margin-top: 30px; }
        .product-card { background: #fff; padding: 15px; border: 1px solid #ddd; border-radius: 8px; width: 250px; text-align: center; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .product-card img { max-width: 100%; height: 200px; object-fit: cover; border-radius: 4px; }
        .btn-buy { background: #007bff; color: white; border: none; padding: 10px 15px; border-radius: 5px; cursor: pointer; font-weight: bold; margin-top: 10px; }
        .btn-buy:hover { background: #0056b3; }
    </style>
</head>
<body>

    <header>
        <h1>Welcome to My Store</h1>
        <p>Call or WhatsApp to inquire: +2348037367998</p>
    </header>

    <main class="product-grid">
        <!-- Sample Product 1 -->
        <div class="product-card">
            <img src="https://placeholder.com" alt="Product Image">
            <h3>Premium Item Name</h3>
            <p>₦15,000</p>
            <!-- If using a checkout provider, you replace this button with their embed link -->
            <button class="btn-buy">Add to Cart</button>
        </div>
    </main>

</body>
</html>
